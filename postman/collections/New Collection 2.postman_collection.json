      "id": "2c82d86e-05ee-445d-ad74-ae6c4fb71b2f",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "e66933f4-ca62-4834-b8e9-2d5cf4536f7e",
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const baseUrl = pm.environment.get(\"BaseUrl\");\r",
              "const email = pm.environment.get(\"mockUserEmail\");\r",
              "const password = pm.environment.get(\"mockUserPassword\");\r",
              "\r",
              "const requestName = pm.info.requestName.toLowerCase();\r",
              "if(requestName.includes(\"login\")){\r",
              "    return;\r",
              "}\r",
              "\r",
              "const existingToken = pm.environment.get(\"token\");\r",
              "if (existingToken) {\r",
              "  console.log(\"Token já existe, pulando auto-login.\");\r",
              "  return;\r",
              "}\r",
              "\r",
              "if (!baseUrl || !email || !password) {\r",
              "  throw new Error(\"Faltou BaseUrl/mockUserEmail/mockUserPassword no Environment.\");\r",
              "}\r",
              "\r",
              "const loginPath = \"/auth/login\";\r",
              "const loginUrl = baseUrl.replace(/\\/$/, \"\") + loginPath;\r",
              "\r",
              "\r",
              "pm.sendRequest(\r",
              "  {\r",
              "    url: loginUrl,\r",
              "    method: \"POST\",\r",
              "    header: {\r",
              "      \"Content-Type\": \"application/json\",\r",
              "      \"Accept\": \"application/json\",\r",
              "    },\r",
              "    body: {\r",
              "      mode: \"raw\",\r",
              "      raw: JSON.stringify({ email, password }),\r",
              "    },\r",
              "  },\r",
              "  function (err, res) {\r",
              "    if (err) {\r",
              "      console.log(\"Erro no login:\", err);\r",
              "      return;\r",
              "    }\r",
              "\r",
              "    if (res.code < 200 || res.code >= 300) {\r",
              "      console.log(\"Login falhou. Status:\", res.code, \"Body:\", res.text());\r",
              "      return;\r",
              "    }\r",
              "    const json = res.json();\r",
              "\r",
              "    const token = json.token;\r",
              "\r",
              "    if (!token) {\r",
              "      console.log(\"JSON login:\", json);\r",
              "      throw new Error(\"Não encontrei token no JSON do login.\");\r",
              "    }\r",
              "\r",
              "    pm.environment.set(\"token\", token);\r",
              "    console.log(\"✅ Token salvo no Environment.\");\r",
              "  }\r",
              ");\r",
              "\r",
              "const getUserUrl = baseUrl.replace(/\\/$/, \"\") + \"/auth/me\";\r",
              "\r",
              "pm.sendRequest(\r",
              "  {\r",
              "    url: getUserUrl,\r",
              "    method: \"GET\",\r",
              "    header: {\r",
              "      \"Content-Type\": \"application/json\",\r",
              "      \"Accept\": \"application/json\",\r",
              "    }\r",
              "  },\r",
              "  function (err, res) {\r",
              "    if (err) {\r",
              "      console.log(\"Erro no login:\", err);\r",
              "      return;\r",
              "    }\r",
              "    if (res.code < 200 || res.code >= 300) {\r",
              "      console.log(\"Endpoint /me falhou. Status:\", res.code, \"Body:\", res.text());\r",
              "      return;\r",
              "    }\r",
              "    const json = res.json();\r",
              "    const userId = json.user.id;\r",
              "    pm.environment.set(\"mockUserId\", userId);\r",
              "    console.log(\"✅ UserId salvo no Environment.\");\r",
              "});\r",
              ""
            ]
          }
        },
