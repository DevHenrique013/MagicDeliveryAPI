                  "script": {
                    "id": "c4a9d106-c0c2-4747-b111-1a1f45500c0b",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {\r",
                      "  pm.environment.unset(\"token\");\r",
                      "  console.log(\"✅ Logout OK: token removido do Environment.\");\r",
                      "} else {\r",
                      "  console.log(\"⚠️ Logout falhou, token mantido. Status:\", pm.response.code);\r",
                      "}\r",
                      "\r",
